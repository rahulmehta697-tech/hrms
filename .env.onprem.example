# Copy to .env next to docker-compose.yml and fill in.
DB_PASSWORD=choose-a-long-database-password
SETUP_KEY=choose-a-long-random-setup-key
# Encrypts Aadhaar numbers. Generate once (openssl rand -base64 32) and never change it, or saved Aadhaar numbers become unreadable.
DATA_KEY=
LICENSE_KEY=
HTTP_PORT=3000
# For the optional HTTPS profile: the name staff will type, already pointing at this server
DOMAIN=hrms.example.in
PRODUCT_NAME=
PRODUCT_URL=
PRODUCT_SUPPORT=
