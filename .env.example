# Neon Postgres connection string (Vercel's Neon integration fills these in for you)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
DATABASE_URL_UNPOOLED=

# Any long random text. Needed once, on the first-run setup page, to create the Master Admin.
SETUP_KEY=change-me-to-a-long-random-string

# Your product brand ("Powered by ..."). Optional; defaults are in src/lib/product.ts
PRODUCT_NAME=
PRODUCT_URL=
PRODUCT_SUPPORT=

# Licence key issued by you for this customer (see LICENSING.md). Optional: the Master Admin can also paste it in the portal.
LICENSE_KEY=
